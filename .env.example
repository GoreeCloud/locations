# Generate each secret independently; never commit .env
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_DB_PASSWORD
BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
PORT=8080
# Optional: for cross-origin local dev only; production web proxies /api
WEB_ORIGIN=http://localhost:5173
# Traccar import script only:
# TRACCAR_URL=https://your-traccar.example
# TRACCAR_USERNAME=
# TRACCAR_PASSWORD=
# TRACCAR_DEVICE_ID=
# IMPORT_API_TOKEN=
# API_URL=http://localhost:8080/api
