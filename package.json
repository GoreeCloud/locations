{
  "name": "goreecloud-locations",
  "private": true,
  "version": "0.1.0-alpha.0",
  "description": "Self-hosted privacy-first location history and family sharing",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev:api": "npm run dev -w @goreecloud/locations-api",
    "dev:web": "npm run dev -w @goreecloud/locations-web",
    "test": "npm run test -w @goreecloud/locations-api",
    "test:integration": "npm run test:integration -w @goreecloud/locations-api",
    "build": "npm run build -w @goreecloud/locations-web",
    "check": "npm run test && npm run build",
    "import:geojson": "node scripts/import-geojson.mjs",
    "import:traccar": "node scripts/import-traccar.mjs"
  }
}
